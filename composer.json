{
    "name": "linquant/render-loop",
    "description": "A render regression net for PHP apps: capture a page's rendered HTML, change it, re-check — only the real change shows, the noise (DebugBar, scripts, CSRF tokens, timestamps) is masked. Semantic HTML diff, automatic noise calibration, golden-master mode. CLI + JSON, usable by a human or an AI agent.",
    "keywords": ["regression", "html", "diff", "approval-testing", "golden-master", "snapshot", "legacy", "characterization-test"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.0 || ^8.0",
        "sebastian/diff": "^5.1 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RenderLoop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RenderLoop\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/render-loop"
    ],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests --level=8 --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
