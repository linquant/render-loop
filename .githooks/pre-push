#!/usr/bin/env bash
#
# pre-push : rejoue localement la pipeline CI avant d'envoyer sur le remote.
# Reproduit les étapes de .github/workflows/ci.yml
# Pour sauter ponctuellement : git push --no-verify
#
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "▶ pre-push : vérifications avant push…"

echo "  → composer validate --strict"
composer validate --strict

echo "  → PHPStan (composer phpstan)"
composer phpstan

echo "  → PHPUnit (composer test)"
composer test

echo "✓ Tout est vert — push autorisé."
