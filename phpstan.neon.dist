parameters:
    level: 10
    # DOM stubs differ between PHP 7.4 and 8.x; runtime narrowing stays meaningful.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    # L'exemple web n'est pas analysé (code applicatif d'intégration), mais ses
    # symboles sont connus pour que les tests de régression de l'exemple passent.
    scanFiles:
        - examples/web/index.php
