#!/usr/bin/env php
<?php

declare(strict_types=1);

use RenderLoop\Command\HtmlCompareCommand;
use Symfony\Component\Console\Application;

// Resolve the autoloader whether this package is the root project or a dependency.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',   // standalone checkout
    __DIR__ . '/../../../autoload.php',    // installed under vendor/linquant/render-loop
];
foreach ($autoloaders as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(HtmlCompareCommand::class)) {
    fwrite(STDERR, "Autoloader introuvable. Lancez `composer install`.\n");
    exit(1);
}

$command = new HtmlCompareCommand();

$application = new Application('render-loop');
// Symfony Console renamed Application::add() to addCommand() in 7.4 and removed
// add() in 8.0; support both so the binary works across 6.4 → 8.x.
if (method_exists($application, 'addCommand')) {
    $application->addCommand($command);
} else {
    $application->add($command);
}
$application->setDefaultCommand('render-loop', true);
$application->run();
